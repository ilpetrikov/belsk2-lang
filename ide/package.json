{
  "name": "belsk2-ide",
  "version": "0.2.0",
  "description": "IDE for belsk2 programming language",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --linux --mac",
    "build:cli": "cargo build --release -p belsk2-cli && node -e \"const fs=require('fs'),p=require('path'),e=process.platform==='win32'?'belsk2.exe':'belsk2';fs.mkdirSync('bin',{recursive:true});fs.copyFileSync(p.join('..','target','release',e),p.join('bin',e))\""
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.belsk2.ide",
    "productName": "belsk2 IDE",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "bin/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
